{
  "version": 2,
  "regions": ["sin1"],
  "env": {
    "NODE_ENV": "production"
  },
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "views/**",
          "public/**",
          "services/**"
        ],
        "maxDuration": 60,
        "memory": 3008
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}