    </script>
  
  <script>
    // Countdown Timer & Real-Time Shift Status Logic
    function updateCountdowns() {
      const now = new Date();
      document.querySelectorAll('[data-target-time]').forEach(el => {
        const targetStr = el.getAttribute('data-target-time');
        const endStr = el.getAttribute('data-end-time');
        const display = el.querySelector('[data-countdown-target]');
        if (!targetStr || !display) return;

        const target = new Date(targetStr);
        if (isNaN(target.getTime())) return;

        let endTarget = endStr ? new Date(endStr) : null;
        if (!endTarget || isNaN(endTarget.getTime())) {
          // Fallback: 150 minutes (2.5 hours) after start time
          endTarget = new Date(target.getTime() + 150 * 60 * 1000);
        }

        const diffStart = target.getTime() - now.getTime();
        const diffEnd = endTarget.getTime() - now.getTime();

        // Reset state classes
        display.classList.remove('is-upcoming', 'is-ongoing', 'is-ended');

        // 1. Session has ended (current time >= end time)
        if (diffEnd <= 0) {
          display.innerText = '✓ Đã kết thúc';
          display.title = `Đã kết thúc lúc ${endTarget.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
          display.classList.add('is-ended');
          return;
        }

        // 2. Session is currently ongoing (diffStart <= 0 and diffEnd > 0)
        if (diffStart <= 0) {
          const minsRemaining = Math.max(1, Math.ceil(diffEnd / (1000 * 60)));
          display.innerText = '● Đang diễn ra';
          display.title = `Đang diễn ra (kết thúc lúc ${endTarget.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}, còn khoảng ${minsRemaining} phút)`;
          display.classList.add('is-ongoing');
          return;
        }

        // 3. Session is upcoming (diffStart > 0)
        display.classList.add('is-upcoming');
        const days = Math.floor(diffStart / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diffStart % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const mins = Math.floor((diffStart % (1000 * 60 * 60)) / (1000 * 60));

        let text = '⏳ Còn ';
        if (days > 0) text += `${days}n `;
        if (hours > 0 || days > 0) text += `${hours}g `;
        text += `${mins}p`;
        if (days === 0 && hours === 0 && mins === 0) {
          text = '⏳ Sắp diễn ra';
        }

        display.innerText = text;
        display.title = `Bắt đầu lúc ${target.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
      });
    }

    // Run every 10 seconds for real-time responsiveness
    setInterval(updateCountdowns, 10000);
    // Initial run
    updateCountdowns();
  </script>
</body>
</html>
