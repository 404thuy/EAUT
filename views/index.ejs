            <% if (result) { %>
            <%
              // Initialize variables with defaults
              let mappedRows = [];
              let weekDays = [];
              let totalSessions = 0;
              let uniqueCourses = 0;
              let uniqueDays = 0;

              // Only process weekly grid if headers and rows exist
              if (result.headers && result.rows) {
                const findHeaderIndex = (patterns) => {
                  if (!result.headers) return -1;
                  return result.headers.findIndex((header) => patterns.some((pattern) => norm(header).includes(pattern)));
                };
                const idxDay = findHeaderIndex(["thu"]);
                const idxDate = findHeaderIndex(["ngay"]);
                const idxCourse = findHeaderIndex(["mon", "hoc phan"]);
                const idxRoom = findHeaderIndex(["phong"]);
                const idxTeacher = findHeaderIndex(["giang vien", "gv", "teacher", "vien"]);
                const idxPeriodStart = findHeaderIndex(["tiet bat dau", "bat dau"]);
                const idxPeriodCount = findHeaderIndex(["so tiet"]);
                const idxTime = findHeaderIndex(["gio hoc", "thoi gian"]);
                const idxSession = findHeaderIndex(["buoi", "ca", "shift"]);
                const idxClass = findHeaderIndex(["lop", "nhom"]);
                const idxMode = findHeaderIndex(["hinh thuc", "cach hoc"]);

                const getDayIndex = (dayText, dateText) => {
                  const d = toInt(dayText);
                  if (d >= 2 && d <= 8) return d;
                  const parsed = parseDate(dateText);
                  if (!parsed) return null;
                  const jsDay = parsed.getDay();
                  return jsDay === 0 ? 8 : jsDay + 1;
                };

                const pickFirstMeaningful = (row, preferredIndexes) => {
                  for (const idx of preferredIndexes) {
                    if (idx < 0) continue;
                    const value = compactText(row[idx] || "");
                    if (!isGenericLabel(value)) return value;
                  }
                  const fallbacks = row
                    .map((cell) => compactText(cell || ""))
                    .filter((cell) => cell && !isGenericLabel(cell) && !/^\d+$/.test(cell));
                  return fallbacks[0] || "";
                };

                const sanitizeField = (value, fallback) => {
                  const text = compactText(value || "");
                  return text && !isGenericLabel(text) ? text : fallback;
                };

                const extractFromRaw = (rawText) => {
                  const text = compactText(String(rawText || "").normalize("NFC"));
                  const teacherMatch = text.match(/(?:GV|Gi[aả]ng\s*vi[eê]n|Giang\s*vien)[:\s]+(.+?)(?=\s*(?:Ph[oò]ng|H[iì]nh\s*th[ứu]c|M[aã]\s*l[oớ]p|Ti[eê]t|$))/i);
                  const roomMatch = text.match(/(?:Phong|Phòng)[:\s]+([^\n]+?)(?=\s*(?:GV|Giảng|Hình|Hinh|Mã|Ma|Tiết|Tiet|$))/i);
                  const dayMatch = text.match(/(?:Thu|Thứ)[:\s]*([2-8])/i);
                  const periodMatch = text.match(/Tiết(?:\s*học)?[:\s]*(\d+)\s*[-–—]\s*(\d+)/i);
                  const periodSingle = text.match(/Tiết(?:\s*học)?[:\s]*(\d{1,2})/i);
                  const coursePart = text.split(/(?:Ti[eê]t|M[aã]\s*l[oớ]p|GV|Gi[aả]ng|Ph[oò]ng|H[iì]nh)/i)[0].replace(/^L[oớ]p\s*h[oọ]c[:\-]?\s*/i, "").trim();
                  const modeMatch = text.match(/(?:Hinh\s*thuc|Hình\s*thức)[:\s]+(.+?)(?=\s*(?:GV|Giảng|Phòng|Phong|Mã|Ma|Tiết|Tiet|$))/i);
                  return {
                    course: coursePart,
                    room: roomMatch ? roomMatch[1].trim() : "",
                    teacher: teacherMatch ? teacherMatch[1].trim() : "",
                    mode: modeMatch ? modeMatch[1].trim() : "",
                    dayIndex: dayMatch ? Number(dayMatch[1]) : null,
                    periodStart: periodMatch ? periodMatch[1] : periodSingle ? periodSingle[1] : "",
                    periodCount: periodMatch ? String(Number(periodMatch[2]) - Number(periodMatch[1]) + 1) : "",
                  };
                };

                const cleanCourseName = (text) => {
                  if (!text) return "";
                  let s = String(text).normalize("NFC").trim();
                  s = s.replace(/\s*[Tt]i[ếe]t\s*[Hh]ọc\s*/gi, "");
                  s = s.replace(/\s*[Tt]i[ếe]t\s*/gi, "");
                  const splitters = [/M[aã]\s*l[oớ]p/i, /GV/i, /Gi[aả]ng\s*vi[eê]n/i, /[:\-\(\[]/];
                  for (const reg of splitters) {
                    const parts = s.split(reg);
                    if (parts.length > 1) s = parts[0];
                  }
                  return s.replace(/\s+[Hh]ọc$/gi, "").replace(/^L[oớ]p\s*h[oọ]c[:\-]?\s*/i, "").trim();
                };

                mappedRows = result.rows.map((row, index) => {
                  const day = idxDay >= 0 ? row[idxDay] || "Không rõ thứ" : "Không rõ thứ";
                  const date = idxDate >= 0 ? row[idxDate] || "" : "";
                  const rawText = compactText(row.join(" "));
                  const parsed = extractFromRaw(rawText);
                  const dayIndex = getDayIndex(day, date) || parsed.dayIndex;
                  const course = pickFirstMeaningful(row, [idxCourse, idxClass]);
                  const room = pickFirstMeaningful(row, [idxRoom]);
                  const teacher = pickFirstMeaningful(row, [idxTeacher]);
                  const time = pickFirstMeaningful(row, [idxTime]);
                  const pStartRaw = idxPeriodStart >= 0 ? row[idxPeriodStart] || "-" : "-";
                  const pCountRaw = idxPeriodCount >= 0 ? row[idxPeriodCount] || "-" : "-";
                  const finalCourse = cleanCourseName(course || parsed.course || "");
                  const finalRoom = room === "Đang cập nhật" ? parsed.room : room;
                  const finalTeacher = teacher === "Đang cập nhật" ? parsed.teacher : teacher;
                  const finalPeriodStart = String(pStartRaw || "-").includes("-") ? String(pStartRaw).split("-")[0].trim() : pStartRaw || parsed.periodStart || "-";
                  const finalPeriodCount = pCountRaw && pCountRaw !== "-" ? pCountRaw : parsed.periodCount || "-";

                  // Correctly determine Hình thức học: Never fallback to date or other columns!
                  const rawMode = idxMode >= 0 && row[idxMode] ? String(row[idxMode]).trim() : "";
                  const rawModeClean = rawMode && rawMode !== "-" && rawMode !== "Đang cập nhật" && !/^\d{1,2}\/\d{1,2}\/\d{2,4}$/.test(rawMode) ? rawMode : (parsed.mode || "");
                  const rawModeLower = rawModeClean.toLowerCase();
                  const roomClean = String(finalRoom || "").trim();
                  const hasRoom = roomClean && roomClean !== "-" && roomClean !== "Đang cập nhật" && !roomClean.toLowerCase().includes("online") && !roomClean.toLowerCase().includes("elearning");

                  let finalMode = "Trực tiếp";
                  if (rawModeLower.includes("elearning") || rawModeLower.includes("online") || rawModeLower.includes("trực tuyến")) {
                    finalMode = "Elearning";
                  } else if (rawModeLower.includes("trực tiếp") || rawModeLower.includes("offline")) {
                    finalMode = "Trực tiếp";
                  } else if (hasRoom) {
                    finalMode = "Trực tiếp";
                  } else {
                    finalMode = "Elearning";
                  }
                  
                  return {
                    id: index,
                    day, date, dayIndex,
                    course: sanitizeField(finalCourse, "Môn học"),
                    room: sanitizeField(finalRoom, "Đang cập nhật"),
                    teacher: sanitizeField(finalTeacher, "Đang cập nhật"),
                    periodStart: sanitizeField(finalPeriodStart, parsed.periodStart || "-"),
                    periodCount: sanitizeField(finalPeriodCount, "-"),
                    time: sanitizeField(time, "-"),
                    mode: finalMode,
                    session: idxSession >= 0 ? String(row[idxSession] || "").trim() : "",
                  };
                }).filter((item) => {
                  const badCourse = isGenericLabel(item.course);
                  const missingMainInfo = item.room === "Đang cập nhật" && item.teacher === "Đang cập nhật" && item.time === "-";
                  return !(badCourse && missingMainInfo);
                });

                mappedRows.sort((a, b) => {
                  const dayA = a.dayIndex || 99;
                  const dayB = b.dayIndex || 99;
                  if (dayA !== dayB) return dayA - dayB;
                  return toInt(a.periodStart) - toInt(b.periodStart);
                });

                weekDays = [2, 3, 4, 5, 6, 7].map((dayIndex) => {
                  const dayItems = mappedRows.filter((item) => item.dayIndex === dayIndex);
                  const dateFromData = dayItems.find((x) => x.date)?.date || "";
                  return {
                    dayIndex,
                    key: `day-${dayIndex}`,
                    title: dayLabel(dayIndex),
                    date: dateFromData,
                    items: dayItems,
                    count: dayItems.length,
                    uniqueCourses: [...new Set(dayItems.map((x) => x.course).filter(Boolean))].length,
                    shifts: [1, 2, 3, 4, 5].map((shift) => ({
                      shift,
                      range: shift === 1 ? "7:00 - 9:30" : shift === 2 ? "9:40 - 12:10" : shift === 3 ? "13:00 - 15:30" : shift === 4 ? "15:40 - 18:10" : "18:30 - 21:00",
                      items: dayItems.filter((item) => shiftFromPeriodStart(item.periodStart, item.session).shift === shift),
                    })),
                  };
                });

                totalSessions = mappedRows.length;
                uniqueCourses = [...new Set(mappedRows.map((row) => row.course).filter(Boolean))].length;
                uniqueDays = weekDays.filter((d) => d.count > 0).length;
              }
            %>
            <section class="panel schedule-panel" id="lich-hoc" data-section="lich-hoc">
          <% if (!result.viewType || result.viewType === 'week') { %>
          <div class="result-header">
            <div>
              <h2>Lịch học của bạn</h2>
              <p class="muted">Cập nhật: <%= result.fetchedAt %></p>
              <% if (result.selectedWeekLabel) { %>
              <p class="muted">Tuần: <%= result.selectedWeekLabel %></p>
              <% } %>
              <p class="muted">
                Số ca trong tuần: <strong><%= totalSessions %></strong> · Số môn khác nhau: <strong><%= uniqueCourses %></strong> · Số ngày có học: <strong><%= uniqueDays %></strong>
              </p>
            </div>
          </div>

          <div class="schedule-toolbar weekly-toolbar">
            <div class="toolbar-group">
              <form action="/schedule/week" method="get" class="week-form">
                <label for="selectedWeek">Tuần học</label>
                <select id="selectedWeek" name="week" onchange="this.form.submit()">
                  <% (result.weekOptions || []).forEach((week) => { %>
                  <option value="<%= week.value %>" <%= week.value === result.selectedWeekValue ? "selected" : "" %>>
                    <%= week.label %>
                  </option>
                  <% }) %>
                </select>
              </form>
            </div>

            <div class="toolbar-group" style="flex:1; min-width: 200px;">
              <label for="subjectFilter">Lọc nhanh</label>
              <input id="subjectFilter" type="text" placeholder="Môn / Phòng / GV..." style="width: 100%;" />
            </div>

            <div class="toolbar-group">
              <label>Chế độ xem</label>
              <div class="view-switch">
                <button type="button" class="btn btn-ghost btn-sm is-active" data-view-mode="table">Bảng</button>
                <button type="button" class="btn btn-ghost btn-sm" data-view-mode="list">Danh sách</button>
              </div>
            </div>
          </div>

          <% if (result.autoSwitchedWeek) { %>
          <div class="alert alert-info">
            <%= result.originalWeekLabel %> hiện chưa có lịch học. Hệ thống tự động chuyển sang <strong><%= result.selectedWeekLabel %></strong> (gần nhất có dữ liệu) để bạn tiện theo dõi.
          </div>
          <% } %>

          <% if (!result.hasData) { %>
          <div class="alert alert-info">
            Đã đăng nhập và mở đúng trang lịch học, nhưng hiện tại không có buổi học nào trong dữ liệu.
            Bạn thử chọn tuần/kỳ khác trên cổng EAUT rồi tải lại.
          </div>
          <% } %>

          <div class="week-board" data-view-block="table">
            <div class="week-board__legend muted">
              Ca 1: 7:00-9:30 · Ca 2: 9:40-12:10 · Ca 3: 13:00-15:30 · Ca 4: 15:40-16:10 · Ca 5: 18:30-21:00
            </div>

            <div class="week-grid-wrap">
              <table class="week-grid" aria-label="Lịch học theo tuần">
                <thead>
                  <tr>
                    <th class="week-grid__corner">Ca</th>
                    <% weekDays.forEach((day) => { %>
                      <th class="week-grid__day" data-day-key="<%= day.key %>">
                        <div class="week-grid__dayTitle"><%= day.title %></div>
                        <% if (day.date) { %><div class="week-grid__dayDate"><%= day.date %></div><% } %>
                        <div class="week-grid__dayCount">Số ca: <strong><%= day.count %></strong></div>
                        <div class="week-grid__dayCount">Số môn: <strong><%= day.uniqueCourses %></strong></div>
                      </th>
                    <% }) %>
                  </tr>
                </thead>
                <tbody>
                  <% [1,2,3,4,5].forEach((shift) => { %>
                    <tr>
                      <th class="week-grid__shift">
                        <div class="week-grid__shiftNum">Ca <%= shift %></div>
                        <div class="week-grid__shiftTime muted">
                          <% 
                            const getTimeRange = (s) => {
                              if (s === 1) return ["7:00", "9:30"];
                              if (s === 2) return ["9:40", "12:10"];
                              if (s === 3) return ["13:00", "15:30"];
                              if (s === 4) return ["15:40", "18:10"];
                              return ["18:30", "21:00"];
                            };
                            const [start, end] = getTimeRange(shift);
                          %>
                          <span><%= start %></span>
                          <div class="shift-divider">-</div>
                          <span><%= end %></span>
                        </div>
                      </th>
                      <% weekDays.forEach((day) => { %>
                        <% const cell = day.shifts.find((s) => s.shift === shift); %>
                        <td class="week-grid__cell" data-day-key="<%= day.key %>" data-shift="<%= shift %>">
                          <% if (cell && cell.items && cell.items.length) { %>
                            <div class="week-grid__cellStack">
                              <% cell.items.forEach((item) => { %>
                                <%
                                  const si = shiftFromPeriodStart(item.periodStart, item.session);
                                  const tietLabel = item.time && item.time !== '-' ? `Tiết ${item.time}` : `Ca ${si.shift}`;
                                  const [tStart, tEnd] = getShiftTimeRange(item, shift);
                                  const startISO = formatISODateTime(day.date, tStart);
                                  const endISO = formatISODateTime(day.date, tEnd);
                                %>
                                  <% const compactStyle = `style="--accent: ${accentFromText(item.course)}; min-height: 90px; display: flex; flex-direction: column; padding: 0.6rem;"`; %>
                                    <div
                                      class="session-item session-item--compact"
                                      <%- compactStyle %>
                                      data-search-content="<%= [item.course, item.teacher, item.room, item.day, item.date, item.time].join(' ').toLowerCase() %>"
                                      data-target-time="<%= startISO %>"
                                      data-end-time="<%= endISO %>"
                                    >
                                      <div class="session-item__top" style="flex-direction: column; align-items: flex-start; gap: 2px; margin-bottom: 6px;">
                                        <div class="session-item__title" style="font-weight: 850; font-size: 0.8rem; line-height: 1.35; color: var(--text-main); width: 100%;"><%= item.course %></div>
                                        <div class="countdown-tag" style="font-size: 0.68rem; font-weight: 800;" data-countdown-target></div>
                                      </div>
                                      
                                      <div class="session-item__sub" style="display: flex; flex-direction: column; gap: 3px; margin-top: auto; border-top: 1px solid var(--line); padding-top: 5px;">
                                        <div style="display: flex; align-items: center; gap: 5px; font-size: 0.72rem;">
                                          <span style="flex: 0 0 15px; font-size: 0.78rem;">📍</span>
                                          <strong style="flex: 1; color: var(--text-main); font-weight: 850;"><%= item.room %></strong>
                                        </div>
                                        <div style="display: flex; align-items: center; gap: 5px; font-size: 0.72rem;">
                                          <span style="flex: 0 0 15px; font-size: 0.78rem;">👤</span>
                                          <span style="flex: 1; color: var(--text-muted); font-weight: 700;"><%= item.teacher %></span>
                                        </div>
                                        <% if (item.mode) { %>
                                          <div style="display: flex; align-items: center; gap: 5px; font-size: 0.72rem;">
                                            <span style="flex: 0 0 15px; font-size: 0.78rem;">📝</span>
                                            <span class="<%= item.mode === 'Trực tiếp' ? 'text-success' : 'text-primary' %>" style="flex: 1; font-weight: 800;"><%= item.mode %></span>
                                          </div>
                                        <% } %>
                                      </div>
                                    </div>
                              <% }) %>
                            </div>
                          <% } else { %>
                            <div class="week-grid__empty"></div>
                          <% } %>
                        </td>
                      <% }) %>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="list-view" data-view-block="list">
            <div class="list-day-tabs">
              <button type="button" class="btn btn-ghost btn-sm is-active" data-day-filter="all">Cả tuần</button>
              <% weekDays.forEach((day) => { %>
                <button type="button" class="btn btn-ghost btn-sm" data-day-filter="<%= day.dayIndex %>">
                  <%= day.title %> (<%= day.count %>)
                </button>
              <% }) %>
            </div>

            <div class="list-day-groups">
              <% weekDays.forEach((day) => { %>
                <% if (day.items.length) { %>
                  <article class="list-day-group" data-day-group="<%= day.dayIndex %>">
                    <header class="list-day-header">
                      <h3><%= day.title %> <% if (day.date) { %>· <%= day.date %><% } %></h3>
                      <div class="count-badge">
                        Số ca: <%= day.count %> · Số môn: <%= day.uniqueCourses %>
                      </div>
                    </header>
                    <div class="list-items">
                      <% day.items.forEach((item, index) => { %>
                        <%
                          const shiftInfo = shiftFromPeriodStart(item.periodStart, item.session);
                          const [tStart, tEnd] = getShiftTimeRange(item, shiftInfo.shift);
                          const startISO = formatISODateTime(day.date, tStart);
                          const endISO = formatISODateTime(day.date, tEnd);
                          const listItemStyle = `style="--accent: ${accentFromText(item.course)}; animation: slideUp 0.6s cubic-bezier(0.23, 1, 0.32, 1) backwards; animation-delay: ${index * 0.05}s;"`;
                        %>
                        <div
                          class="list-item"
                          <%- listItemStyle %>
                          data-search-content="<%= [item.course, item.teacher, item.room, item.day, item.date, item.time].join(' ').toLowerCase() %>"
                          data-day-index="<%= item.dayIndex || '' %>"
                          data-target-time="<%= startISO %>"
                          data-end-time="<%= endISO %>"
                        >
                          <div class="list-item__left">
                            <div class="shift-name">Ca <%= shiftInfo.shift %></div>
                            <div class="shift-time"><%= shiftInfo.range %></div>
                          </div>
                          <div class="list-item__right">
                            <div class="list-item__top" style="display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 6px;">
                                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                                  <h4 style="margin: 0; font-size: 0.84rem; font-weight: 800; color: var(--text-main);"><%= item.course %></h4>
                                  <div class="countdown-tag" style="font-size: 0.65rem; font-weight: 700;" data-countdown-target></div>
                                </div>
                                <% if (item.time && item.time !== '-') { %>
                                  <div class="tiet-badge" style="flex-shrink: 0; background: var(--accent); color: white; padding: 4px 6px; border-radius: 6px; display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 40px;">
                                    <span style="font-size: 0.55rem; font-weight: 800; text-transform: uppercase; line-height: 1; opacity: 0.9; margin-bottom: 2px;">Tiết</span>
                                    <span style="font-size: 0.8rem; font-weight: 900; line-height: 1;"><%= item.time %></span>
                                  </div>
                                <% } %>
                            </div>
                            <div class="meta" style="display: flex; flex-direction: row; flex-wrap: wrap; gap: 15px; align-items: center; margin-top: 4px;">
                              <div style="display: flex; align-items: center; gap: 4px; font-size: 0.75rem; color: var(--text-muted);">
                                <span style="opacity: 0.7;">📍</span>
                                <span>Phòng: <strong style="color: var(--text-main);"><%= item.room %></strong></span>
                              </div>
                              <div style="display: flex; align-items: center; gap: 4px; font-size: 0.75rem; color: var(--text-muted);">
                                <span style="opacity: 0.7;">👤</span>
                                <span>Giảng viên: <strong style="color: var(--text-main);"><%= item.teacher %></strong></span>
                              </div>
                              <% if (item.mode) { %>
                                <div style="display: flex; align-items: center; gap: 4px; font-size: 0.75rem; color: var(--text-muted);">
                                  <span style="opacity: 0.7;">📝</span>
                                  <span>Hình thức: <strong class="<%= item.mode === 'Trực tiếp' ? 'text-success' : 'text-primary' %>" style="font-weight: 800;"><%= item.mode %></strong></span>
                                </div>
                              <% } %>
                            </div>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  </article>
                <% } %>
              <% }) %>
            </div>
          </div>
          <% } else if (result.viewType === 'term') { %>
            <div class="term-view">
              <!-- Compact & Clean Semester Toolbar -->
              <div class="schedule-toolbar term-toolbar" style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.6rem 1rem; border-radius: var(--radius-md); margin-bottom: 1.25rem;">
                
                <form action="/schedule/term" method="get" class="week-form" style="display: flex; align-items: center; gap: 0.6rem; flex: 1; min-width: 0; margin: 0;">
                  <label for="selectedSemester" style="font-size: 0.8rem; font-weight: 800; color: var(--text-muted); white-space: nowrap; margin: 0; display: flex; align-items: center; gap: 0.35rem;">
                    <span>🎓</span> Học kỳ:
                  </label>
                  <select id="selectedSemester" name="semester" onchange="this.form.submit()"
                          style="flex: 1; max-width: 320px; font-size: 0.82rem; font-weight: 700; padding: 0.4rem 0.75rem; border-radius: var(--radius-sm); border: 1px solid var(--line); background: var(--surface-solid); color: var(--text-main); cursor: pointer;">
                    <% (result.semesterOptions || []).forEach((opt) => { %>
                      <% const isSelected = result.selectedSemester ? (opt.value === result.selectedSemester || opt.label === result.selectedSemester) : opt.selected; %>
                      <option value="<%= opt.value %>" <%= isSelected ? "selected" : "" %>><%= opt.label %></option>
                    <% }) %>
                  </select>
                </form>

                <div style="display: flex; align-items: center; gap: 0.65rem; flex-shrink: 0;">
                  <% if (result.fetchedAt) { %>
                    <% const fetchDate = new Date(result.fetchedAt); %>
                    <span style="font-size: 0.68rem; color: var(--text-dim); white-space: nowrap;">
                      🕒 <%= fetchDate.toLocaleTimeString('vi-VN', {hour:'2-digit', minute:'2-digit'}) %> <%= fetchDate.toLocaleDateString('vi-VN') %>
                    </span>
                  <% } %>
                  <a href="/schedule/term?semester=<%= result.selectedSemester || 'all' %>&refresh=1"
                     class="btn btn-ghost btn-sm"
                     style="display: flex; align-items: center; gap: 0.3rem; text-decoration: none; font-size: 0.75rem; font-weight: 700; border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.35rem 0.65rem; color: var(--text-muted); transition: all var(--transition);"
                     title="Làm mới dữ liệu từ trường">
                    🔄 Làm mới
                  </a>
                </div>

              </div>

              <% if (!result.results || result.results.length === 0 || result.results.every(r => r.rows.length === 0)) { %>
                <div class="alert alert-info" style="margin-top: 2rem;">
                  Đã đăng nhập thành công nhưng không tìm thấy dữ liệu lịch học trong học kỳ này.
                  Bạn hãy thử chọn một học kỳ khác hoặc chọn <strong>"Xem tất cả học kỳ"</strong>.
                </div>
              <% } %>

              <% (result.results || []).reverse().forEach((semResult, semIndex) => { %>
                <%
                  const grouped = new Map();
                  semResult.rows.forEach(row => {
                    let id = "", name = "", className = "", credits = "", fee = "", teacher = "", sched = "", room = "", mode = "";

                    if (row && typeof row === "object" && !Array.isArray(row)) {
                      id = row.id || "";
                      name = row.name || "";
                      className = row.className || "";
                      credits = row.credits || "";
                      fee = row.fee || "";
                      teacher = row.teacher || "";
                      sched = row.sched || "";
                      room = row.room || "";
                      mode = row.mode || "";
                    } else if (Array.isArray(row)) {
                      row.forEach(cell => {
                        let text = (cell || "").replace(/<br\s*\/?>/gi, " ").replace(/<[^>]*>/g, "").replace(/\s*Có mặt\s*/gi, "").replace(/\s+/g, " ").trim();
                        if (!text || text === "-" || text === "0" || norm(text) === "dang cap nhat") return;
                        const lower = norm(text);
                        if (lower.includes("hoc binh thuong") || lower.includes("hoc lai") || lower.includes("hoc cai thien")) return;
                        const shiftParts = lower.split(" | ").map(x => x.trim());
                        if (shiftParts.length > 0 && shiftParts.every(x => ["sang", "chieu", "toi", "ca 1", "ca 2", "ca 3", "ca 4"].includes(x))) return;
                        if (lower.includes("truc tiep") || lower.includes("offline")) { mode = "Trực tiếp"; }
                        else if (lower.includes("elearning") || lower.includes("truc tuyen") || lower.includes("online")) { mode = "Elearning"; }
                        else if (/^\d{1,3}([,.]\d{3})+$/.test(text)) { fee = text; }
                        else if (/\d{2}\/\d{2}\/\d{2,4}/.test(text) || lower.includes("thu ") || lower.includes("tiet ")) { sched = sched ? sched + " | " + text : text; }
                        else if (/toa nha|building|eaut|phong|tầng|tang/i.test(lower) || /^[A-Z]\d{2,3}$/.test(text)) { room = text; }
                        else if (text.includes(" - ") && /[A-Z0-9._]{5,}/.test(text)) {
                          const parts = text.split(" - ");
                          if (!name) name = parts[0].trim();
                          className = parts.slice(1).join(" - ").trim();
                          if (!id) id = className.split(".")[0] || className;
                        }
                        else if (/^[A-Z]{2,6}\d{3,6}$/i.test(text)) { id = text; }
                        else if (/(?:^[A-ZĐ0-9]{2,10}\.\d+)|(?:^[A-ZĐ0-9_.]+(?:_LT|_TH|LT|TH)$)/i.test(text)) { className = text; }
                        else if (/^\d{1,2}$/.test(text) && !credits && !fee) { credits = text; }
                        else if (!name && text.length > 3 && !lower.includes("tong so") && !/^\d+$/.test(text)) { name = text; }
                        else if (name && !teacher && text.length > 5 && !/\d/.test(text)) { teacher = text; }
                      });
                    }

                    if (!name) name = id || className || "Môn học";
                    if (!id) id = className || "N/A";
                    if (!className) className = "Chưa có lớp";
                    if (!teacher) teacher = "Đang cập nhật";
                    if (!room) room = "Đang cập nhật";
                    if (name === "Tổng số" || name === "Môn học") return;

                    const rawRoomClean = (room || "").trim();
                    const hasRoomInitial = rawRoomClean && rawRoomClean !== "-" && rawRoomClean !== "Đang cập nhật" && !rawRoomClean.toLowerCase().includes("online") && !rawRoomClean.toLowerCase().includes("elearning") && !rawRoomClean.toLowerCase().includes("e-learning");
                    if (!mode) {
                      mode = hasRoomInitial ? "Trực tiếp" : "Elearning";
                    }

                    const hasValidFee = !!fee;
                    const key = deduplicate(name).toLowerCase();
                    let item;
                    if (!grouped.has(key)) {
                      item = { id, name: deduplicate(name), className: deduplicate(className), credits, teacher: deduplicate(teacher), room: deduplicate(room), mode: deduplicate(mode), schedules: [], hasValidFee };
                      grouped.set(key, item);
                    } else {
                      item = grouped.get(key);
                      if (hasValidFee && !item.hasValidFee) {
                        item.id = id; item.className = deduplicate(className); item.credits = credits;
                        item.teacher = deduplicate(teacher); item.room = deduplicate(room);
                        if (mode) item.mode = deduplicate(mode);
                        item.schedules = []; item.hasValidFee = true;
                      } else if (!hasValidFee && item.hasValidFee) {
                        if (item.className !== deduplicate(className)) return;
                      } else if (item.className !== deduplicate(className)) { return; }
                      if (mode === "Trực tiếp") item.mode = "Trực tiếp";
                    }

                    const sText = deduplicate(sched);
                    const rText = item.room;
                    const isElearning = (!rText || rText === "Đang cập nhật" || rText === "-" || rText === "0") && (!sText || sText === "-" || sText === "0");

                    let fullSched = "";
                    if (isElearning) {
                      fullSched = "Môn học E-learning";
                    } else {
                      let dates = sText.match(/\d{2}\/\d{2}\/\d{2,4}/g) || [];
                      if (dates.length >= 2) {
                        let parsed = dates.map(d => { let [D, M, Y] = d.split("/"); if (Y.length === 2) Y = "20" + Y; return new Date(`${Y}-${M}-${D}`).getTime(); }).filter(n => !isNaN(n));
                        if (parsed.length > 0) {
                          let minDate = new Date(Math.min(...parsed)); let maxDate = new Date(Math.max(...parsed));
                          let fMin = `${String(minDate.getDate()).padStart(2,'0')}/${String(minDate.getMonth()+1).padStart(2,'0')}/${String(minDate.getFullYear())}`;
                          let fMax = `${String(maxDate.getDate()).padStart(2,'0')}/${String(maxDate.getMonth()+1).padStart(2,'0')}/${String(maxDate.getFullYear())}`;
                          fullSched = `${fMin} → ${fMax}`;
                        } else { fullSched = sText ? sText.split(" | ")[0] : "Chưa có lịch"; }
                      } else if (dates.length === 1) {
                        fullSched = `Bắt đầu ${dates[0]}`;
                      } else {
                        fullSched = sText ? sText.split(" | ")[0] : "Chưa có lịch";
                      }
                    }
                    if (fullSched && !item.schedules.includes(fullSched)) { item.schedules.push(fullSched); }
                  });
                %>

                <% if (grouped.size > 0) { %>
                  <!-- Semester Header -->
                  <% const semHeaderStyle = `style="margin-top: ${semIndex === 0 ? '0' : '2.5rem'}; padding-bottom: 0.6rem; border-bottom: 2px solid var(--primary); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;"`; %>
                  <div <%- semHeaderStyle %>>
                    <div>
                      <h2 style="margin: 0; font-size: 1.1rem; font-weight: 900; color: var(--primary);"><%= semResult.semester %></h2>
                    </div>
                    <div style="display: flex; align-items: center; gap: 1rem;">
                      <div style="font-size: 0.75rem; color: var(--text-dim); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.25rem 0.75rem;">
                        📚 <strong style="color: var(--text-main);"><%= grouped.size %></strong> môn
                      </div>
                      <div style="font-size: 0.75rem; color: var(--text-dim); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 0.25rem 0.75rem;">
                        🎓 <strong style="color: var(--primary);"><%= [...grouped.values()].reduce((acc, curr) => acc + (parseFloat(curr.credits) || 0), 0) %></strong> tín chỉ
                      </div>
                    </div>
                  </div>

                  <!-- Course Cards Grid -->
                  <div class="term-grid" style="margin-top: 1rem;">
                    <% let cardIndex = 0; for (const item of grouped.values()) { cardIndex++; %>
                      <%
                        const cleanField = (str) => String(str || "")
                          .replace(/<br\s*\/?>/gi, " ").replace(/&lt;br\s*\/?&gt;/gi, " ")
                          .replace(/<[^>]*>/g, "").replace(/&lt;[^&]*&gt;/gi, "")
                          .replace(/\s*Có mặt\s*/gi, "").replace(/\s+/g, " ").trim();

                        const nameWords = cleanField(item.name).split(" ").filter(Boolean);
                        const badgeText = nameWords.length >= 2
                          ? (nameWords[0][0] + nameWords[1][0]).toUpperCase()
                          : cleanField(item.name).substring(0, 2).toUpperCase();
                        const accentColor = accentFromText(item.name);
                        const cleanClass = cleanField(item.className || item.id);
                        const subjectName = cleanField(item.name);
                        const headerClassCode = cleanClass.replace(subjectName, '').replace(/^[\s\-_.]+/, '').trim();

                        // Determine room display
                        let roomDisplay = item.schedules.some(s => s.includes('E-learning')) && item.room === 'Đang cập nhật' ? 'E-learning' : cleanField(item.room);

                        const rClean = (roomDisplay || "").trim();
                        const hasValidRoom = rClean && rClean !== "-" && rClean !== "Đang cập nhật" && !rClean.toLowerCase().includes("online") && !rClean.toLowerCase().includes("elearning") && !rClean.toLowerCase().includes("e-learning");

                        let termMode = "Trực tiếp";
                        const itemModeLower = (item.mode || "").toLowerCase();
                        if (itemModeLower.includes("elearning") || itemModeLower.includes("online") || itemModeLower.includes("trực tuyến") || rClean.toLowerCase().includes("elearning") || rClean.toLowerCase().includes("e-learning")) {
                          termMode = "Elearning";
                        } else if (itemModeLower.includes("trực tiếp") || itemModeLower.includes("offline")) {
                          termMode = "Trực tiếp";
                        } else if (hasValidRoom) {
                          termMode = "Trực tiếp";
                        } else {
                          termMode = "Elearning";
                        }

                        // Schedule display
                        const hasNoSched = item.schedules.length === 0 || (item.schedules.length === 1 && item.schedules[0] === "Chưa có lịch");
                        const cardStyle = `style="--accent: ${accentColor}; animation: slideUp 0.5s cubic-bezier(0.23,1,0.32,1) backwards; animation-delay: ${cardIndex * 0.04}s;"`;
                        const badgeStyle = `style="background: ${accentColor}; color: #fff; font-size: 0.7rem; padding: 0.25rem 0.6rem; border-radius: 6px; font-weight: 900; flex-shrink: 0; min-width: 32px; text-align: center;"`;
                      %>
                      <div class="term-card" <%- cardStyle %>>

                        <!-- Card Header: Badge + Class code (without subject name) -->
                        <div class="term-card__header">
                          <div class="course-badge" <%- badgeStyle %>>
                            <%= badgeText %>
                          </div>
                          <div style="flex: 1; min-width: 0; text-align: right; font-size: 0.65rem; color: var(--text-dim); font-weight: 700; line-height: 1.3; word-break: break-all; padding-left: 0.4rem;">
                            <% if (headerClassCode) { %>
                              <span style="color: var(--text-muted);"><%= headerClassCode %></span>
                              <span style="color: var(--text-dim);"> · </span>
                            <% } %>
                            <span style="color: var(--primary); font-weight: 900;"><%= item.credits %> tín</span>
                          </div>
                        </div>

                        <!-- Subject name -->
                        <h3 style="margin: 0; font-size: 0.86rem; font-weight: 800; color: var(--text-main); line-height: 1.35; word-break: break-word; overflow-wrap: break-word;"><%= cleanField(item.name) %></h3>

                        <!-- Meta info -->
                        <div style="display: flex; flex-direction: column; gap: 0.3rem; margin-top: 0.2rem;">

                          <!-- Class -->
                          <div style="display: flex; align-items: flex-start; gap: 0.4rem; font-size: 0.72rem;">
                            <span style="flex-shrink: 0; opacity: 0.7; margin-top: 1px;">🏷️</span>
                            <div style="flex: 1; min-width: 0; color: var(--text-muted); line-height: 1.4; word-break: break-all; overflow-wrap: break-word;">
                              Lớp: <strong style="color: var(--text-main);"><%= cleanClass %></strong>
                            </div>
                          </div>

                          <!-- Teacher -->
                          <div style="display: flex; align-items: flex-start; gap: 0.4rem; font-size: 0.72rem;">
                            <span style="flex-shrink: 0; opacity: 0.7; margin-top: 1px;">👤</span>
                            <div style="flex: 1; min-width: 0; color: var(--text-muted); line-height: 1.4; word-break: break-word;">
                              GV: <strong style="color: var(--text-main);"><%= cleanField(item.teacher) %></strong>
                            </div>
                          </div>

                          <!-- Room -->
                          <div style="display: flex; align-items: flex-start; gap: 0.4rem; font-size: 0.72rem;">
                            <span style="flex-shrink: 0; opacity: 0.7; margin-top: 1px;">📍</span>
